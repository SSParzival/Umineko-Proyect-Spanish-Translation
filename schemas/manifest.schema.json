{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://umineko-project.local/schemas/manifest.schema.json",
  "title": "Umineko Project es.file Extraction Manifest",
  "type": "object",
  "required": [
    "schema_version",
    "tool_version",
    "container",
    "script_metadata",
    "catalog_files",
    "block_files"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0"
    },
    "tool_version": {
      "type": "string"
    },
    "container": {
      "type": "object",
      "required": [
        "format",
        "magic",
        "key_flag",
        "encoding",
        "zlib_level",
        "zlib_wbits",
        "zlib_mem_level",
        "original_file_size",
        "original_comp_size",
        "original_uncomp_size",
        "original_sha256",
        "original_zlib_adler32",
        "plaintext_sha256",
        "trailing_newline"
      ],
      "properties": {
        "format": { "type": "string", "const": "ONS2" },
        "magic": { "type": "string", "const": "ONS2" },
        "key_flag": { "type": "integer", "const": 110 },
        "encoding": { "type": "string", "const": "utf-8" },
        "zlib_level": { "type": "integer", "minimum": 1, "maximum": 9 },
        "zlib_wbits": { "type": "integer", "const": 15 },
        "zlib_mem_level": { "type": "integer", "minimum": 1, "maximum": 9 },
        "original_file_size": { "type": "integer", "minimum": 16 },
        "original_comp_size": { "type": "integer", "minimum": 16 },
        "original_uncomp_size": { "type": "integer", "minimum": 16 },
        "original_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "original_zlib_adler32": { "type": "string", "pattern": "^[0-9a-f]{8}$" },
        "plaintext_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "trailing_newline": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "script_metadata": {
      "type": "object",
      "required": ["mode_directive", "gameid", "total_lines", "total_entries"],
      "properties": {
        "mode_directive": { "type": "string" },
        "gameid": { "type": "string" },
        "version": { "type": "string" },
        "releasedate": { "type": "integer" },
        "localisation": { "type": "string" },
        "total_lines": { "type": "integer", "minimum": 1 },
        "total_entries": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": false
    },
    "catalog_files": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["path", "category", "section", "entry_count", "sha256"],
        "properties": {
          "path": { "type": "string" },
          "category": { "type": "string", "enum": ["story", "omake", "strings"] },
          "episode": { "type": ["string", "null"] },
          "section": { "type": "string" },
          "entry_count": { "type": "integer", "minimum": 0 },
          "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
        },
        "additionalProperties": false
      }
    },
    "block_files": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["path", "section", "line_count", "sha256"],
        "properties": {
          "path": { "type": "string" },
          "section": { "type": "string" },
          "line_count": { "type": "integer", "minimum": 1 },
          "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
