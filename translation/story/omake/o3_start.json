      "segments": [
        {
          "index": 0,
          "text": "¡Felicidades!",
          "inline_tags": []
        },
        {
          "index": 1,
          "text": " Te tomó algo de tiempo, pero finalmente llegaste hasta aquí.",
          "inline_tags": []
        },
        {
          "index": 2,
          "text": "{n}{n}Por todo tu esfuerzo, la Bruja Dorada te ha entregado la llave del Archivo de Lord {f:5:Goldsmith}.",
          "inline_tags": [
            "{n}",
            "{n}",
            "{f:5:Goldsmith}"
          ]
        },
        {
          "index": 3,
          "text": " Para ti, puede convertirse en un lugar de descanso y añorar recuerdos largamente olvidados.",
          "inline_tags": []
        },
        {
          "index": 4,
          "text": "{n}{n}¡Buena suerte en tu travesía por llegar al final del juego!",
          "inline_tags": [
            "{n}",
            "{n}"
          ]
        }
      ],
      "text": "¡Felicidades!  Te tomó algo de tiempo, pero finalmente llegaste hasta aquí. {n}{n}Por todo tu esfuerzo, la Bruja Dorada te ha entregado la llave del Archivo de Lord {f:5:Goldsmith}.  Para ti, puede convertirse en un lugar de descanso y añorar recuerdos largamente olvidados. {n}{n}¡Buena suerte en tu travesía por llegar al final del juego!",
      "inline_tags": [
        "{n}",
        "{n}",
        "{f:5:Goldsmith}",
        "{n}",
        "{n}"
      ],
